{
  "sourceLanguage": "en",
  "strings": {
    "%@ (partly)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (частично)"
          }
        }
      }
    },
    "Addresses or networks (1.2.3.0/24) jink should also unblock.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреса или сети (1.2.3.0/24), которые jink тоже должен разблокировать."
          }
        }
      }
    },
    "Addresses or networks jink should leave alone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреса или сети, которые jink не должен трогать."
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительно"
          }
        }
      }
    },
    "All addresses": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все адреса"
          }
        }
      }
    },
    "Also treat traffic to these addresses, whatever the site name.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрабатывать трафик к этим адресам, каким бы ни было имя сайта."
          }
        }
      }
    },
    "Also unblock game traffic to the servers of the IP list.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировать и игровой трафик к серверам из списка IP."
          }
        }
      }
    },
    "Another app (a VPN?) routes all traffic, so jink stands aside.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое приложение (VPN?) направляет весь трафик через себя, поэтому jink не вмешивается."
          }
        }
      }
    },
    "Another copy of jink is running.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже запущена другая копия jink."
          }
        }
      }
    },
    "Background service": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновая служба"
          }
        }
      }
    },
    "Built-in list": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенный список"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить"
          }
        }
      }
    },
    "Connecting to the background service…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение к фоновой службе…"
          }
        }
      }
    },
    "Details": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подробности"
          }
        }
      }
    },
    "Excluded IPs": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исключённые IP"
          }
        }
      }
    },
    "Excluded sites": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исключённые сайты"
          }
        }
      }
    },
    "Find the best strategy": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подобрать лучшую стратегию"
          }
        }
      }
    },
    "Finding a strategy: trying %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подбор стратегии: пробуем %@"
          }
        }
      }
    },
    "Finding a strategy…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подбор стратегии…"
          }
        }
      }
    },
    "Gaming": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игры"
          }
        }
      }
    },
    "Gaming mode": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игровой режим"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основные"
          }
        }
      }
    },
    "IP list": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список IP"
          }
        }
      }
    },
    "IPs": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "IP-адреса"
          }
        }
      }
    },
    "Install service": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установить службу"
          }
        }
      }
    },
    "It did not get online in time.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось вовремя выйти в сеть."
          }
        }
      }
    },
    "It needs to be installed once; macOS asks for an administrator password.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её нужно установить один раз; macOS запросит пароль администратора."
          }
        }
      }
    },
    "Kept %@: %lld of %lld checks passed (%lld without jink).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрана %@: пройдено %lld из %lld проверок (без jink — %lld)."
          }
        }
      }
    },
    "My IPs": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои IP"
          }
        }
      }
    },
    "My sites": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои сайты"
          }
        }
      }
    },
    "No network: the sites could not be reached at all.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сети: до сайтов вообще не удалось достучаться."
          }
        }
      }
    },
    "No strategy did better than without jink.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одна стратегия не сработала лучше, чем без jink."
          }
        }
      }
    },
    "Nothing is blocked here: every site works without jink.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь ничего не заблокировано: все сайты работают без jink."
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено"
          }
        }
      }
    },
    "On": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено"
          }
        }
      }
    },
    "On, but not working: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено, но не работает: %@"
          }
        }
      }
    },
    "On, checking the network…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено, проверка сети…"
          }
        }
      }
    },
    "On, via %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено, через %@"
