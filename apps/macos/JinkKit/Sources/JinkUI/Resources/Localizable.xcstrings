    "Reinstall service": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переустановить службу"
          }
        }
      }
    },
    "Remove service": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить службу"
          }
        }
      }
    },
    "Revert": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить изменения"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить"
          }
        }
      }
    },
    "Settings show once the background service runs.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки появятся, когда заработает фоновая служба."
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки…"
          }
        }
      }
    },
    "Sites": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайты"
          }
        }
      }
    },
    "Sites jink should also unblock: one per line; links are fine.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайты, которые jink тоже должен разблокировать: по одному в строке, можно ссылками."
          }
        }
      }
    },
    "Sites jink should leave alone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайты, которые jink не должен трогать."
          }
        }
      }
    },
    "Some connections went through unchanged.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые соединения прошли без обработки."
          }
        }
      }
    },
    "Some entries are not valid; nothing was saved.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые записи неверны; ничего не сохранено."
          }
        }
      }
    },
    "Some settings are not valid.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые настройки неверны."
          }
        }
      }
    },
    "Starting…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запуск…"
          }
        }
      }
    },
    "Stopped: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановлено: %@"
          }
        }
      }
    },
    "Strategy": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стратегия"
          }
        }
      }
    },
    "TCP and UDP": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TCP и UDP"
          }
        }
      }
    },
    "TCP ports": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порты TCP"
          }
        }
      }
    },
    "Takes a minute or two. Sites may not open meanwhile.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это займёт минуту-две. Пока сайты могут не открываться."
          }
        }
      }
    },
    "The background service answered something this app does not understand. Update the service.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновая служба ответила непонятно для этого приложения. Обновите службу."
          }
        }
      }
    },
    "The background service did not answer.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновая служба не ответила."
          }
        }
      }
    },
    "The background service is from another version of jink.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновая служба — от другой версии jink."
          }
        }
      }
    },
    "The request did not reach the background service.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос не дошёл до фоновой службы."
          }
        }
      }
    },
    "The service does not know the strategy %@. Update the service.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба не знает стратегию %@. Обновите службу."
          }
        }
      }
    },
    "The service does not run as administrator.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба запущена без прав администратора."
          }
        }
      }
    },
    "There is no network.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сети."
          }
        }
      }
    },
    "This copy of the app is damaged: download it again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта копия приложения повреждена: скачайте её заново."
          }
        }
      }
    },
    "This strategy does not work with these settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта стратегия не работает с такими настройками."
          }
        }
      }
    },
    "Turn on when the Mac starts": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включать при запуске Mac"
          }
        }
      }
    },
    "UDP ports": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порты UDP"
          }
        }
      }
    },
    "Update service": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновить службу"
          }
        }
      }
    },
    "Without jink": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без jink"
          }
        }
      }
    },
    "a non-Latin name: enter its xn-- form": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "имя не латиницей: введите его в форме xn--"
          }
        }
      }
    },
    "an IP address: put it under IPs": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "это IP-адрес: добавьте его в IP-адреса"
          }
        }
      }
    },
    "an empty line": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "пустая строка"
          }
        }
      }
    },
    "connection cut": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "соединение оборвано"
          }
        }
      }
    },
    "jink could not create its network interface.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "jink не смог создать свой сетевой интерфейс."
          }
        }
      }
    },
    "jink could not read or change the network routes.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "jink не смог прочитать или изменить сетевые маршруты."
          }
        }
      }
    },
    "jink could not remove all of its network routes.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "jink не смог удалить все свои сетевые маршруты."
          }
        }
      }
    },
    "jink could not save its settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "jink не смог сохранить настройки."
          }
        }
      }
    },
    "jink could not see or send network traffic.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "jink не смог видеть или отправлять сетевой трафик."
          }
        }
      }
    },
    "jink stopped unexpectedly.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "jink неожиданно остановился."
          }
        }
      }
    },
    "jink's background service is not running.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновая служба jink не запущена."
          }
        }
      }
    },
    "name not found": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "имя не найдено"
          }
        }
      }
    },
