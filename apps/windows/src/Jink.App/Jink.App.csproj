<!-- The Windows app: the tray icon, its window and the settings window,
     over Jink.Core. Built with WinUI 3 (Windows App SDK, carried along so
     nothing else needs installing); its UI is made in C#, not XAML, so it
     also compiles (and is analyzed) on macOS, where the XAML compiler does
     not run. Only Windows packs it into a runnable app. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 version 1809 and later. -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Jink.App</RootNamespace>
    <AssemblyName>jink-app</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\jink.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Main is ours (Program.cs): there is no App.xaml to make one. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <!-- Windows: carry the Windows App SDK and .NET along. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform(Windows))">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <!-- Elsewhere: compile and analyze only; the resource index and the
       manifest are made by Windows tools. -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform(Windows))">
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Jink.Core\Jink.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The Windows App SDK adds source files of its own to the app (they set
       up its runtime). They are Microsoft's, not jink's: analyzers skip
       them, through a config naming exactly those files, made at build
       time because their path is on this machine's package folder. -->
  <Target Name="SkipAnalyzingPackageSources" BeforeTargets="CoreCompile" AfterTargets="GenerateUndockedRegFreeWinRTCS">
    <ItemGroup>
      <_PackageSource Include="@(Compile->'%(FullPath)')" Condition="$([System.String]::Copy('%(Compile.FullPath)').StartsWith('$(NuGetPackageRoot)', StringComparison.OrdinalIgnoreCase))" />
      <_PackageSource>
        <ConfigPath>$([System.String]::Copy('%(FullPath)').Replace('\', '/'))</ConfigPath>
      </_PackageSource>
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)package-sources.globalconfig" Lines="is_global = true;@(_PackageSource->'[%(ConfigPath)]%0Adotnet_analyzer_diagnostic.severity = none')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <GlobalAnalyzerConfigFiles Include="$(IntermediateOutputPath)package-sources.globalconfig" />
    </ItemGroup>
  </Target>
</Project>
